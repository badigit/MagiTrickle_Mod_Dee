# Адреса роутеров в репозитории не хранятся. Скопируй в .router.env (он в .gitignore)
# и подставь свои значения; скрипты подхватят файл сами.
#
#   cp .router.env.example .router.env

# ssh-цель основного (aarch64) роутера: алиас из ~/.ssh/config или user@адрес
ROUTER_SSH=root@192.0.2.1
# порт ssh, если цель задана адресом, а не алиасом
ROUTER_PORT=222
# адрес роутера для http-запросов к API (MagiTrickle :8080, mihomo :9090)
ROUTER_IP=192.0.2.1

# ssh-цель mipsel-роутера, если он отдельный
ROUTER_SSH_MIPSEL=root@192.0.2.2

# адрес этой машины в LAN — нужен тестам, которые ходят через роутер обратно
LOCAL_IP=192.0.2.100
