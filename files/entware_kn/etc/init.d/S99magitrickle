#!/bin/sh

ENABLED=yes
PROCS=magitrickled
ARGS=""
PREARGS=""
DESC="MagiTrickle Daemon"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UPTIME_MAX_BORDER=300

# Диагностический лог демона. По умолчанию stdout/stderr уходят в /dev/null:
# zerolog пишет в stderr строку на каждый DNS-запрос, а на роутере флеш дорогой.
# Включить: touch /opt/var/lib/magitrickle/debug-log  (и перезапустить демон).
# Уровень задаётся отдельно: ARGS="--log-level debug".
DEBUG_LOG_FLAG=/opt/var/lib/magitrickle/debug-log
DEBUG_LOG_FILE=/opt/var/log/magitrickle.log
DEBUG_LOG_MAX_KB=5120

ACTION=$1
CALLER=$2

ansi_red="\033[1;31m";
ansi_white="\033[1;37m";
ansi_green="\033[1;32m";
ansi_yellow="\033[1;33m";
ansi_blue="\033[1;34m";
ansi_bell="\007";
ansi_blink="\033[5m";
ansi_std="\033[m";
ansi_rev="\033[7m";
ansi_ul="\033[4m";

get_uptime() {
    cut -d. -f1 /proc/uptime
}

# run_daemon запускает демон в фоне. По умолчанию вывод отбрасывается; при
# наличии флаг-файла пишется в лог — без этого причина падения демона нигде не
# сохраняется (logger в start() срабатывает лишь когда процесс не поднялся
# вовсе, а он успевает подняться и умереть позже — mt-2jb). Лог усекается по
# достижении лимита: logrotate на роутере нет.
run_daemon() {
  if [ ! -f "$DEBUG_LOG_FLAG" ]; then
    $PREARGS $PROC $ARGS > /dev/null 2>&1 &
    return 0
  fi

  mkdir -p "${DEBUG_LOG_FILE%/*}" 2>/dev/null
  if [ -f "$DEBUG_LOG_FILE" ]; then
    SIZE_KB=`du -k "$DEBUG_LOG_FILE" 2>/dev/null | cut -f1`
    if [ -n "$SIZE_KB" ] && [ "$SIZE_KB" -gt "$DEBUG_LOG_MAX_KB" ]; then
      : > "$DEBUG_LOG_FILE"
    fi
  fi
  echo "--- $DESC starting at `date` ---" >> "$DEBUG_LOG_FILE"
  $PREARGS $PROC $ARGS >> "$DEBUG_LOG_FILE" 2>&1 &
}

startup_loop() {
  $PRECMD > /dev/null 2>&1
  STEP=5
  COUNTER=0
  while :; do
    if [ "`get_uptime`" -gt "$UPTIME_MAX_BORDER" ]; then
      break
    fi
    if [ -n "`pidof $PROC`" ]; then
      sleep $STEP
      continue
    fi

    logger "Starting $DESC from $CALLER (Attempt #`expr $COUNTER + 1`)."
    run_daemon
    sleep $STEP
    if [ -z "`pidof $PROC`" ]; then
      logger "Failed to start $DESC from $CALLER (Attempt #`expr $COUNTER + 1`)."
    fi
    COUNTER=`expr $COUNTER + 1`
  done

  if [ -z "`pidof $PROC`" ]; then
    logger "Failed to start $DESC from $CALLER."
    return 255
  else
    logger "Started $DESC from $CALLER."
    return 0
  fi
}

start() {
  [ "$CRITICAL" != "yes" -a "$CALLER" = "cron" ] && return 7
  [ "$ENABLED" != "yes" ] && return 8
  echo -e -n "$ansi_white Starting $DESC... $ansi_std"

  if [ -n "`pidof $PROC`" ]; then
    echo -e "            $ansi_yellow already running. $ansi_std"
    return 0
  fi

  if [ "`get_uptime`" -le "$UPTIME_MAX_BORDER" ]; then
    echo -e "            $ansi_yellow in loop (until uptime $UPTIME_MAX_BORDER)... $ansi_std"
    startup_loop &
    return 0
  fi

  $PRECMD > /dev/null 2>&1
  run_daemon
  COUNTER=0
  LIMIT=10
  while [ -z "`pidof $PROC`" -a "$COUNTER" -le "$LIMIT" ]; do
    sleep 1;
    COUNTER=`expr $COUNTER + 1`
  done
  $POSTCMD > /dev/null 2>&1

  if [ -z "`pidof $PROC`" ]; then
    echo -e "            $ansi_red failed. $ansi_std"
    logger "Failed to start $DESC from $CALLER."
    return 255
  else
    echo -e "            $ansi_green done. $ansi_std"
    logger "Started $DESC from $CALLER."
    return 0
  fi
}

stop() {
  echo -e -n "$ansi_white Shutting down $PROC... $ansi_std"
  killall $PROC 2>/dev/null
  COUNTER=0
  LIMIT=10
  while [ -n "`pidof $PROC`" -a "$COUNTER" -le "$LIMIT" ]; do
    sleep 1;
    COUNTER=`expr $COUNTER + 1`
  done

  # Если процесс не уложился в LIMIT (graceful teardown iptables/ipset под
  # нагрузкой может выйти за это время) - добиваем SIGKILL. Без этого restart()
  # ниже вызовет start() поверх ещё живого, но уже обречённого процесса: start()
  # увидит его в pidof, решит что "already running" и не поднимет замену -
  # а через несколько секунд старый процесс всё равно умрёт сам, оставив демон
  # мёртвым насовсем (mt-cub, инцидент 2026-07-26 при opkg-деплое).
  if [ -n "`pidof $PROC`" ]; then
    logger "$DESC did not stop within ${LIMIT}s, sending SIGKILL."
    killall -9 $PROC 2>/dev/null
    COUNTER=0
    KILL_LIMIT=5
    while [ -n "`pidof $PROC`" -a "$COUNTER" -le "$KILL_LIMIT" ]; do
      sleep 1;
      COUNTER=`expr $COUNTER + 1`
    done
  fi

  if [ -n "`pidof $PROC`" ]; then
    echo -e "            $ansi_red failed. $ansi_std"
    logger "Failed to stop $DESC even after SIGKILL."
    return 255
  else
    echo -e "            $ansi_green done. $ansi_std"
    return 0
  fi
}

check() {
  echo -e -n "$ansi_white Checking $DESC... $ansi_std"
  if [ -n "`pidof $PROC`" ]; then
    echo -e "            $ansi_green alive. $ansi_std";
    return 0
  else
    echo -e "            $ansi_red dead. $ansi_std";
    return 1
  fi
}

reconfigure() {
  SIGNAL=SIGHUP
  echo -e "$ansi_white Sending $SIGNAL to $PROC... $ansi_std"
  killall -$SIGNAL $PROC 2>/dev/null
}

for PROC in $PROCS; do
  case $ACTION in
    start)
      start
      ;;
    stop)
      check && stop
      ;;
    restart)
      check > /dev/null && stop
      start
      ;;
    check|status)
      check
      ;;
    reconfigure)
      reconfigure
      ;;
    *)
      echo -e "$ansi_white Usage: $0 (start|stop|restart|check|status|reconfigure)$ansi_std"
      exit 1
      ;;
  esac
done
